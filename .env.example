# WhatsApp Business Cloud API (Meta) — see WHATSAPP.md
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; enter the same value in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=
# Meta App > Settings > Basic > App secret (used to verify webhook signatures)
WHATSAPP_APP_SECRET=
# Random secret protecting /api/whatsapp/send and /api/whatsapp/messages
WHATSAPP_API_KEY=
# Optional: automatic reply text for every incoming message
WHATSAPP_AUTO_REPLY=
# Optional
WHATSAPP_GRAPH_VERSION=v21.0
